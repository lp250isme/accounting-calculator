// Cloudflare Workers Static Assets（Vercel 遷移，vercel.json 保留供退回）。
// 純靜態：沒有 main，所有請求由 assets 直接回應，不吃 Worker CPU/請求額度。
// 切網域時才加 routes（例："routes": [{ "pattern": "accounting.kvcc.me", "custom_domain": true }]），現在加會撞既有 DNS 紀錄。
// 部署：npm run build && npx wrangler@latest deploy
{
  "name": "accounting",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  // CUTOVER: uncomment after deleting the old Vercel DNS record for this host
  // "routes": [{ "pattern": "accounting.kvcc.me", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
